# ── Discord ──────────────────────────────────────────────────────────────────
# Portal de desarrolladores: https://discord.com/developers/applications
DISCORD_TOKEN=TU_TOKEN_DEL_BOT
DISCORD_CLIENT_ID=TU_APPLICATION_ID
# Solo necesario para la Activity (OAuth2 → Client Secret)
DISCORD_CLIENT_SECRET=TU_CLIENT_SECRET

# ── Jellyfin ─────────────────────────────────────────────────────────────────
# URL accesible desde donde corre el bot (LAN vale si el bot corre en casa)
JELLYFIN_URL=http://192.168.1.10:8096
# Panel de Jellyfin → Consola → API Keys
JELLYFIN_API_KEY=TU_API_KEY_JELLYFIN

# ── Calidad del stream del bot (opcional) ────────────────────────────────────
#STREAM_WIDTH=1280
#STREAM_HEIGHT=720
#STREAM_FPS=30
#STREAM_BITRATE_KBPS=3000
#STREAM_MAX_BITRATE_KBPS=5000
#STREAM_HWACCEL=false
#STREAM_VIDEO_CODEC=H264

# ── Activity (opcional) ──────────────────────────────────────────────────────
#PORT=3001
